<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TargetFramework>net10.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="IconSets" />
        <!-- Generated by the .NET tool in Tools/IconSets from pinned icon sources. -->
        <EmbeddedResource Include="Res\*.json.gz" />
        <None Include="Res\*.LICENSE" />
    </ItemGroup>

</Project>
